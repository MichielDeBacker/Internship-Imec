#!/bin/bash
#SBATCH --job-name=slyb_seq
#SBATCH --partition=hopper_gpu
#SBATCH --gres=gpu:1
#SBATCH --cpus-per-task=4
#SBATCH --mem=16G
#SBATCH --time=01:00:00
#SBATCH --output=logs/sequence_%A_%a.out
#SBATCH --error=logs/sequence_%A_%a.err

set -euo pipefail

PIPELINE_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CONFIG="${CONFIG:-$PIPELINE_ROOT/config/slyb_hydra.yaml}"
PIPELINE_PYTHON="${PIPELINE_PYTHON:-python3}"

BASE=/scratch/brussel/vo/000/bvo00014/vsc39230
CACHE="$BASE/cache/prosapia_binder_pipeline/sequence/${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
mkdir -p "$CACHE/tmp" "$CACHE/xdg" "$CACHE/torch"
export TMPDIR="$CACHE/tmp"
export XDG_CACHE_HOME="$CACHE/xdg"
export TORCH_HOME="$CACHE/torch"

cd "$PIPELINE_ROOT"
"$PIPELINE_PYTHON" scripts/02_sequence_one.py \
    --config "$CONFIG" \
    --index "$SLURM_ARRAY_TASK_ID"
